{
  "name": "@puralex/image-audit",
  "version": "0.3.1",
  "description": "Lint and audit image references in web projects — find broken links, unused images, duplicates, format mismatches, and overused assets.",
  "type": "module",
  "license": "MIT",
  "author": "Puralex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnifito/image-audit.git"
  },
  "homepage": "https://github.com/magnifito/image-audit#readme",
  "bugs": {
    "url": "https://github.com/magnifito/image-audit/issues"
  },
  "scripts": {
    "generate-fixtures": "node test/generate-fixtures.js",
    "test": "node test/generate-fixtures.js && node --test test/run.js",
    "test:coverage": "node test/generate-fixtures.js && node --test --experimental-test-coverage test/run.js",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "image-audit": "bin/image-audit.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "CHANGELOG.md"
  ],
  "types": "./types/index.d.ts",
  "keywords": [
    "image",
    "audit",
    "lint",
    "broken-links",
    "unused-images",
    "duplicates",
    "compat",
    "astro",
    "mdx",
    "web"
  ],
  "dependencies": {
    "file-type": "^21.3.4"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
